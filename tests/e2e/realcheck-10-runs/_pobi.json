tion_tags":[],"dialogue_seed":"","emotion_stage":"","script_full":"INT. 前东家大厦 大堂 - 下午\n\n巨大的 LED 屏滚动着公司价值观。陆青棠 (35) 穿着干净的米色风衣，工牌已经被她摘下，握在手心。\n\nHR 站在前台，礼貌而客气。\n\nHR\n青棠姐，签个字就可以了。\n\n她把工牌放到回收盒里。塑料壳磕在金属盒底，发出一声很轻的脆响。\n\n陆青棠\n（看一眼大屏）\n「以客户为中心」——\n我做了 7 年。\n\nHR 没接话。\n\n陆青棠转身走出大堂。门外的太阳很烈。\n她没戴墨镜，眼眶通红地直视前方。\n\n旁白（V.O.，陆青棠）\n我以为出局就是终点。\n后来才知道，那只是另一种开局。\n\n黑场。\n","screenplay_notes":""},{"id":"scene_05-zhichang-shangzhan_1","order_index":2,"title":"合伙人邀约","pov_character_id":"char_05-zhichang-shangzhan_0","location":"城市西郊 一家旧厂房改造的咖啡店","time_of_day":"","goal":"说服对方","obstacle":"她还在防对方报复","tactic":"","turn":"达成但有意外后果","value_shift":"","new_information":[],"input_state":"","output_state":"","production_tags":[],"dialogue_seed":"","emotion_stage":"","script_full":"","screenplay_notes":""},{"id":"scene_05-zhichang-shangzhan_2","order_index":3,"title":"投资人圆桌","pov_character_id":"char_05-zhichang-shangzhan_0","location":"国贸 32 楼 投资机构会议室","time_of_day":"","goal":"说服对方","obstacle":"7 个 NO，时间只有 90 分钟","tactic":"","turn":"目标失败","value_shift":"","new_information":[],"input_state":"","output_state":"","production_tags":[],"dialogue_seed":"","emotion_stage":"","script_full":"","screenplay_notes":""}],"setup_payoffs":[]},"story_core":{"premise":"在头部互联网大厂被裁员的女产品总监带着一个被否决过 3 次的提案离职，转身加入了 7 年前被她亲手压制的竞品创始人组成的小团队。","core_conflict":"","central_question":"","emotional_promise":"","theme_statement":"","ending_direction":""},"genre_profile":{"primary_genre":"职场 · 商战创业","secondary_genres":[],"audience_promise":"","tone_words":[],"conventions":[],"taboos":[]},"character_hub":{"characters":[{"id":"char_05-zhichang-shangzhan_0","name":"陆青棠","story_role":"protagonist","external_goal":"把自己 7 年内压在抽屉里的提案做成行业现象级产品","dramatic_need":"她当年压住的竞品，让 27 岁的对方差点跳楼","contradiction":"","starting_mask":"","pressure_point":"她当年压住的竞品，让 27 岁的对方差点跳楼","arc_start":"从制度内的胜者","arc_end":"制度外的合作者","secret":"","notes":"","archetype":"主角","traits":[],"status":"active","linked_plot_ids":["plot_05-zhichang-shangzhan_0","plot_05-zhicha