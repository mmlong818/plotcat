roup_id":"scenario_core","notes":""}],"scenario_groups":[{"id":"scenario_core","title":"方案对照","question":"当前主问题有哪些不同解法","status":"exploring","promoted_lane_id":null,"notes":""}],"view_mode":"structure"},"scene_workbench":{"scenes":[{"id":"scene_01-shanhun-haomen_0","order_index":1,"title":"退婚酒会","act_id":"act_mpo77e8l_k1eej1","linked_plot_card_ids":[],"pov_character_id":"char_01-shanhun-haomen_0","location":"璇宫酒店 · 主厅","time_of_day":"","purpose":"说服对方","obstacle":"未婚夫提前买通司仪当众宣读分手","beat_summary":"目标失败","entry_state":"","exit_state":"","status":"outline","script_excerpt":"","script_full":"INT. 璇宫酒店 主厅 - 夜\n\n水晶吊灯刺眼。订婚酒会的香槟塔旁，苏念安一身银色晚礼服，礼貌地微笑。\n\n司仪敲了下话筒。\n\n司仪\n（带着歉意）\n各位来宾，临时通知一下——\n\n未婚夫从人群里走出，手里攥着话筒。\n\n未婚夫\n对不起，念安，我们的婚约……到此为止。\n\n全场寂静。镁光灯像审讯。\n\n苏念安\n（极轻）\n就在今天？\n\n她把香槟杯轻轻放回托盘，转身走向吧台。脚步不快，但每一步都像踩在自己心上。\n\n吧台旁一个男人正在低头看手机。深灰西装，没认得出来是谁。\n\n苏念安\n（伸手把对方领带绕在自己手心）\n配合一下，三秒钟。\n\n霍奕琛抬头，眼神没动，嘴角却很慢地翘了一下。\n\n霍奕琛\n（低声）\n三秒？我以为你想要一辈子。\n\nCUT TO 黑场。\n","screenplay_notes":"","notes":""},{"id":"scene_01-shanhun-haomen_1","order_index":2,"title":"婚书惊魂","act_id":"act_mpo77e8l_k1eej1","linked_plot_card_ids":[],"pov_character_id":"char_01-shanhun-haomen_0","location":"霍氏总裁套房","time_of_day":"","purpose":"揭露真相","obstacle":"记忆断片，证人只有对面的男人","beat_summary":"达成但有意外后果","entry_state":"","exit_state":"","status":"outline","script_excerpt":"","script_full":"","screenplay_notes":"","notes":""},{"id":"scene_01-shanhun-haomen_2","order_index":3,"title":"雨夜机场","act_id":"act_mpo77e8l_1vmysz","linked_plot_card_ids":[],"pov_character_id":"char_01-shanhun-haomen_1","location":"首都国际机场 T3","time_of_day":"","purpose":"保护某人","obstacle":"她已经过了安检","beat_summary":"达成但有意外后果","entry_state":"","exit_state":"","status":"outline","script_excerpt":"","script_full":"","screenplay_notes":"","notes":""}]},"lock_layer":{"locked_plot_ids":[],"projections":{"characters":[{"id":"char_01-shanhun-haomen_0","name":"苏念安","story_role":"protagonist","external_goal":"把自己的设计品牌做大，证明退婚不是她的错","dramatic_need":"5 岁被生母抛弃，怕被任何人再选择性放弃","contradiction":"","starting_mask":"","pressure_point":"5 岁被生母抛弃，怕被任何人再选择性放弃","arc_start":"从用婚姻自证","arc_end":"接受自己本身就值得被爱","secret":"","notes":"","archetype":"主角","traits":[],"status":"active","linked_plot_ids":["plot_01-shanhun-haomen_0","plot_01-shanhun-haomen_1","plot_01-shanhun-haomen_2","plot_01-shanhun-haomen_3","plot_01-shanhun-haomen_4","plot_01-shanhun-haomen_5","plot_01-shanhun-haomen_6","plot_01-shanhun-haomen_7"]},{"id":"char_01-shanhun-haomen_1","name":"霍奕琛","story_role":"antagonist","external_goal":"维系霍氏家族秩序，逼母亲承认他作为继承人的合法性","dramatic_need":"母亲是父亲的情人，他生下来就被原配家族敌视","contradiction":"","starting_mask":"","pressure_point":"母亲是父亲的情人，他生下来就被原配家族敌视","arc_start":"把「利用对方」的合约","arc_end":"真正学会向人示弱","secret":"","notes":"","archetype":"对手","traits":[],"status":"active","linked_plot_ids":[]},{"id":"char_01-shanhun-haomen_2","name":"顾婉清","story_role":"ally","external_goal":"保护闺蜜苏念安，也借机进入霍家圈层做品牌联营","dramatic_need":"和苏念安共同度过孤儿院少年时期","contradiction":"","starting_mask":"","pressure_point":"和苏念安共同度过孤儿院少年时期","arc_start":"从代偿照顾","arc_end":"学会先安顿自己","secret":"","notes":"","archetype":"盟友","traits":[],"status":"active","linked_plot_ids":[]}],"relationships":[{"id":"rel_01-shanhun-haomen_0","source_character_id":"char_01-shanhun-haomen_0","target_character_id":"char_01-shanhun-haomen_1","relationship_type":"强制婚约","tension":"一纸领证书把两个想互相利用的人锁在一起","power_balance":"霍奕琛掌握所有信息和资源，苏念安只能见招拆招","shared_history":"酒会前并不相识，但都被同一个媒体勒索过","hidden_information":"霍奕琛其实在三年前的设计展上就注意过苏念安","status":"active","related_plot_ids":[]},{"id":"rel_01-shanhun-haomen_1","source_character_id":"char_01-shanhun-haomen_0","target_character_id":"char_01-shanhun-haomen_2","relationship_type":"手足战友","tension":"顾婉清比苏念安更早看出霍奕琛动了真心","power_balance":"情感对等，但顾婉清主动挡刀的次数更多","shared_history":"孤儿院共读 10 年","hidden_information":"顾婉清正在偷偷帮苏念安整理生母资料","status":"active","related_plot_ids":[]}],"world_rules":[],"timeline_events":[],"setup_payoffs":[]}}},"projects":[{"id":"project_mpo77e8l_0l10r2","title":"闪婚豪门","format":"feature_or_p